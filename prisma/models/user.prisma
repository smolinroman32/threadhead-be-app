model User {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  age          Int
  email        String   @unique
  passwordHash String
  tokenVersion Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  socialAccounts   SocialAccount[]
  opportunityFeeds OpportunityFeed[]
  onboarding       Onboarding?
}
