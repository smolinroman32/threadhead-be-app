model OpportunityFeed {
  id              String         @id @default(uuid()) @db.Uuid
  name            String
  description     String         @default("")
  color           String         @default("#5F947B")
  intent          String
  includeTerms    String[]
  excludeTerms    String[]
  languages       String[]
  freshnessHours  Int
  minScore        Int
  isActive        Boolean        @default(true)
  userId          String         @db.Uuid
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  searchQueries   SearchQuery[]
  opportunities   Opportunity[]
  targetAudience  String
  onboardingId    String?        @unique @db.Uuid
  socialAccountId String?        @db.Uuid
  socialAccount   SocialAccount? @relation(fields: [socialAccountId], references: [id], onDelete: Restrict)
  scoringVersion  Int            @default(1)
  discoveryRuns   DiscoveryRun[]
}
