enum SearchQueryType {
  KEYWORD
  PHRASE
}

model SearchQuery {
  id                       String                   @id @default(uuid()) @db.Uuid
  opportunityFeedId        String                   @db.Uuid
  opportunityFeed          OpportunityFeed          @relation(fields: [opportunityFeedId], references: [id], onDelete: Cascade)
  query                    String
  type                     SearchQueryType
  isActive                 Boolean
  matchedPosts             Int
  relevantPosts            Int
  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt
  opportunitySearchQueries OpportunitySearchQuery[]
}
