model Opportunity {
  id                String          @id @default(uuid()) @db.Uuid
  opportunityFeedId String          @db.Uuid
  opportunityFeed   OpportunityFeed @relation(fields: [opportunityFeedId], references: [id], onDelete: Cascade)
  authorUsername String
  text String
  permalink String
  publishedAt DateTime
  score Int
  reason String
  status String
    createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

}
