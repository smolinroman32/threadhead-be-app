enum OpportunityStatus {
  NEW
  SAVED
  DISMISSED
  REPLIED
}

model Opportunity {
  id                       String                   @id @default(uuid()) @db.Uuid
  opportunityFeedId        String                   @db.Uuid
  opportunityFeed          OpportunityFeed          @relation(fields: [opportunityFeedId], references: [id], onDelete: Cascade)
  externalPostId           String
  authorUsername           String
  text                     String
  permalink                String
  publishedAt              DateTime
  relevanceScore           Int
  reason                   String
  status                   OpportunityStatus
  scoringVersion           Int
  excludedTerm             String?
  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt
  opportunitySearchQueries OpportunitySearchQuery[]

  @@unique([opportunityFeedId, externalPostId])
}
