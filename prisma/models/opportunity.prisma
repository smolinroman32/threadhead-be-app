//   id string pk
//   opportunityFeedId string
//   authorUsername string
//   text string
//   permalink string
//   publishedAt Date
//   score number
//   reason string
//   status string
//   createdAt Date
//   updatedAt Date

model Opportunity {
  id                       String                   @id @default(uuid()) @db.Uuid
  opportunityFeedId        String                   @db.Uuid
  opportunityFeed          OpportunityFeed          @relation(fields: [opportunityFeedId], references: [id], onDelete: Cascade)
  externalPostId           String
  authorUsername           String
  text                     String
  permalink                String
  publishedAt              DateTime
  score                    Int
  reason                   String
  status                   String
  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt
  opportunitySearchQueries OpportunitySearchQuery[]
}
